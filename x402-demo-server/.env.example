# x402 Resource Server — Environment Variables
# Copy this file to .env and fill in your values

# Your Algorand wallet address that receives USDC payments
# Must be opted into USDC TestNet ASA (ID: 10458941)
AVM_ADDRESS=your_algorand_testnet_wallet_address_here

# GoPlausible x402 Facilitator URL
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server port (default: 4021)
PORT=4021
